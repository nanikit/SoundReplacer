<settings-container spacing="2" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
  <dropdown-list-setting options="sound-list" value="good-hitsound" text="Good hit sound" apply-on-change="true" />
  <dropdown-list-setting options="sound-list" value="bad-hitsound" text="Bad hit sound" apply-on-change="true" />
  <dropdown-list-setting options="sound-list" value="bomb-hitsound" text="Bomb hit sound" apply-on-change="true" />
  <dropdown-list-setting options="sound-list" value="menu-music" text="Menu music" apply-on-change="true" />
  <dropdown-list-setting options="sound-list" value="click-sound" text="Click sound" apply-on-change="true" />
  <dropdown-list-setting options="sound-list" value="success-sound" text="Level success" apply-on-change="true" />
  <dropdown-list-setting options="sound-list" value="fail-sound" text="Level fail" apply-on-change="true" />
  <checkbox-setting value="lock-pitch" text="Lock pitch" apply-on-change="true" bind-value="true" />
  <dropdown-list-setting options="cut-sound-volume-methods" value="cut-sound-volume-method" text="Cut sound volume method" apply-on-change="true" />
  <slider-setting text="Music decibel offset" min="-10" max="10" value="music-decibel-offset" increment="0.5" apply-on-change="true" bind-value="true" />
  <slider-setting text="Sfx multiplier" min="0" max="3" value="sfx-decibel-multiplier" increment="0.05" apply-on-change="true" bind-value="true" />
  <slider-setting text="Sfx decibel offset" min="0" max="24" value="sfx-decibel-offset" increment="0.5" apply-on-change="true" bind-value="true" />
</settings-container>
